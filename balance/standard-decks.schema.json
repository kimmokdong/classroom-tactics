{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-tactics.local/schemas/standard-decks.schema.json",
  "title": "교실 대전 표준 덱",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rulesVersion", "deckSetVersion", "primaryCheckpoint", "checkpoints", "decks", "legacyAudit"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "rulesVersion": { "const": "standard-decks-v1" },
    "deckSetVersion": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
    "primaryCheckpoint": { "$ref": "#/$defs/id" },
    "checkpoints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/checkpoint" } },
    "decks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/deck" } },
    "legacyAudit": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/audit" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "phase", "boardLevel"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "phase": { "enum": ["core", "final"] },
        "boardLevel": { "enum": [7, 8, 9] }
      }
    },
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "strategyGroup", "checkpointId", "sourceLegacyIds", "migrationStatus",
        "changeReason", "units", "fixedItems", "roles", "expectedSynergies", "defaultItemSet", "tags", "notes"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "strategyGroup": { "enum": ["reroll_core7", "reroll_final8", "standard_core8", "standard_final9", "highvalue_final9"] },
        "checkpointId": { "$ref": "#/$defs/id" },
        "parentDeckId": { "$ref": "#/$defs/id" },
        "sourceLegacyIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "migrationStatus": { "enum": ["modified", "reclassified", "new-design"] },
        "changeReason": { "type": "string", "minLength": 1 },
        "units": { "type": "array", "minItems": 7, "maxItems": 9, "items": { "$ref": "#/$defs/unit" } },
        "fixedItems": { "const": true },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mainTank", "mainDealer", "subDealer"],
          "properties": {
            "mainTank": { "type": "string" },
            "mainDealer": { "type": "string" },
            "subDealer": { "type": "string" }
          }
        },
        "expectedSynergies": { "type": "array", "items": { "$ref": "#/$defs/expectedSynergy" } },
        "defaultItemSet": { "enum": ["baseline6", "capped9"] },
        "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "notes": { "type": "string" }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitId", "star", "items", "position", "positionGroup"],
      "properties": {
        "unitId": { "type": "string", "pattern": "^u[1-5]_[0-9]+$" },
        "star": { "type": "integer", "minimum": 1, "maximum": 3 },
        "items": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1 } },
        "itemExceptionReason": { "type": "string", "minLength": 1 },
        "position": { "type": "integer", "minimum": 0, "maximum": 23 },
        "positionGroup": { "enum": ["front-center", "front-side", "mid-side", "back-center", "back-side"] }
      }
    },
    "expectedSynergy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "level"],
      "properties": {
        "type": { "enum": ["subjects", "clubs"] },
        "name": { "type": "string", "minLength": 1 },
        "level": { "type": "integer", "minimum": 1 }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "category", "level", "unitIds", "disposition", "targetDeckIds", "reason"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/id" },
        "category": { "type": "string", "minLength": 1 },
        "level": { "enum": [7, 8, 9, 10] },
        "unitIds": { "type": "array", "minItems": 7, "maxItems": 10, "uniqueItems": true, "items": { "type": "string" } },
        "disposition": { "enum": ["usable", "modified", "reclassified", "excluded", "needs-new-design"] },
        "targetDeckIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
